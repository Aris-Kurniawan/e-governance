{
  "name": "simakis",
  "version": "0.1.0",
  "private": true,
  "description": "SIMAKIS — Scripts pengembangan monorepo (backend FastAPI + frontend Vite). Paket aplikasi tetap berada di backend/ dan frontend/.",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && ./venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "wait-on --interval 2 --timeout 180000 http-get://localhost:8000/health && npm --prefix frontend run dev -- --host 0.0.0.0",
    "dev:backend:only": "cd backend && ./venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend:only": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "cd backend && ./venv/bin/python -m pytest tests/ -q"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4"
  }
}
