# .env.production.example — Template environment untuk deploy produksi
# Isi nilai sesuai lingkungan produksi, lalu rename ke .env.production
# Selalu simpan di luar git! (lihat GIT_WORKFLOW.md §5)

# ==========================================
# KONFIGURASI PRODUKSI - SIMAKIS BACKEND
# ==========================================

# Mode Aplikasi
APP_NAME=SIMAKIS
DEBUG=False

# Database MySQL di dalam Docker Compose (lihat docker-compose.yml)
DATABASE_URL=mysql+pymysql://${MYSQL_USER:-simakis}:${MYSQL_PASSWORD}@mysql:3306/simakis

# Keamanan Auth & JWT — GENERATE BARU DI PRODUKSI!
JWT_SECRET=generate-a-strong-secret-at-least-64-chars-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# PDP Vault — GENERATE BARU! (32 karakter)
PDP_ENCRYPTION_KEY=32-character-encryption-key-prod-changeme

# Object Storage (MinIO di dalam Docker)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=simakis-media

# AI Pipeline
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ==========================================
# KONFIGURASI DOCKER COMPOSE (service environment)
# ==========================================

# Database MySQL credentials
MYSQL_ROOT_PASSWORD=prod_root_password_change_this
MYSQL_USER=simakis
MYSQL_PASSWORD=prod_simakis_password_change_this

# MinIO credentials (sama dengan di atas, untuk konsistensi)
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ==========================================
# CATATAN PENTING
# ==========================================
# 1. Jangan pernah commit file ini ke git (sudah ada di .gitignore).
# 2. Setelah diisi nilai real, rename ke `.env.production` dan simpan di root.
# 3. Docker Compose akan membaca file `.env.production` otomatis.
# 4. Untuk custom environment variable lain, tambahkan di sini.
